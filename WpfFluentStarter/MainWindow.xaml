<Window x:Class="WpfFluentStarter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WpfFluentStarter.ViewModels"
        xmlns:misc="clr-namespace:WpfFluentStarter.Misc"
        xmlns:converters="clr-namespace:WpfFluentStarter.Converters"
        xmlns:models="clr-namespace:WpfFluentStarter.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="RootWindow"
        DataContext="{Binding Source={StaticResource Locator}, Path=MainWindow}"
        Closing="Window_Closing"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Title="WPF FluentUI Starter" Height="800" Width="1157">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadDocumentCommand}"/>
        <KeyBinding Key="Q" Modifiers="Ctrl" Command="{Binding QuitCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ShowAboutWindowCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewDocumentCommand}"/>
    </Window.InputBindings>
    
    <Window.Resources>
        <converters:MaximizedToVisibilityConverter x:Key="MaxToVisibilityConverter"/>
        <converters:RestoredToVisibilityConverter x:Key="RestoreToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome 
            CaptionHeight="32" 
            ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
            GlassFrameThickness="0"
            CornerRadius="0"
            NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Viewbox Width="16" Height="16" Margin="12,0,12,0">
                        <Path Fill="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                      Data="M12,2L1,21H23M12,6L19.53,19H4.47" />
                    </Viewbox>
                    <Menu FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGestureText="Ctrl+N"/>
                            <MenuItem Header="_Save" Command="{Binding SaveDocumentCommand}" InputGestureText="Ctrl+S"/>
                            <MenuItem Header="_Load" Command="{Binding LoadDocumentCommand}" InputGestureText="Ctrl+O"/>
                            <Separator/>
                            <MenuItem Header="_Exit" Command="{Binding QuitCommand}" InputGestureText="Ctrl+Q"/>
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                            <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="_About" Command="{Binding ShowAboutWindowCommand}" InputGestureText="Ctrl+H"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        HorizontalAlignment="Right">

                    <Button x:Name="MinimizeButton" Style="{DynamicResource MinimizeButtonStyle}" Click="MinimizeButton_Click" />
                    <Button x:Name="RestoreButton" Style="{DynamicResource MaximizeButtonStyle}" Click="MaximizeRestoreButton_Click" Visibility="{Binding ElementName=RootWindow, Path=WindowState, Converter={StaticResource MaxToVisibilityConverter}}"  />
                    <Button x:Name="MaximizeButton" Style="{DynamicResource RestoreButtonStyle}"  Click="MaximizeRestoreButton_Click" Visibility="{Binding ElementName=RootWindow, Path=WindowState, Converter={StaticResource RestoreToVisibilityConverter}}"  />
                    <Button x:Name="CloseButton" Command="{Binding QuitCommand}" Style="{DynamicResource CloseButtonStyle}" />

                </StackPanel>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Controls -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Settings -->
                        <GroupBox Header="Furniture Design" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <Label Content="Document Name:"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                            </StackPanel>
                        </GroupBox>
                        <!-- Components -->
                        <GroupBox Header="Tools" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <Button HorizontalAlignment="Stretch" Content="Add Table" Command="{Binding AddTableCommand}" Margin="5,0"/>
                                <Button HorizontalAlignment="Stretch" Content="Scramble" Command="{Binding ScrambleCommand}" Margin="5,5"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"/>

                <!-- Right Column: Preview & Editor -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="White"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="60" Height="60" Background="{Binding ColorHex}"  BorderBrush="#333" BorderThickness="2" CornerRadius="4">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>